<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#40000000"/> <!-- Semi-transparent black for shadow -->
        </shape>
    </item>

    <!-- Actual Button -->
    <item android:top="4dp" android:left="4dp"> <!-- Moves button on top of shadow -->
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#282F66"/> <!-- Button Color -->
        </shape>
    </item>
</layer-list>
